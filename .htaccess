Options -Indexes
DirectoryIndex index.php

# Block direct access to internal and private files (works on Hostinger LiteSpeed and Apache)
<FilesMatch "^(config\.php|config\.sample\.php|schoolfee-config\.php|\.env.*|.*\.sql|.*\.lock|.*\.md|composer\.(json|lock))$">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
  </IfModule>
</FilesMatch>

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteRule ^(inc|pages)(/|$) - [F,L]
  RewriteRule ^install/schema\.php$ - [F,L]
</IfModule>

<IfModule mod_headers.c>
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "same-origin"
</IfModule>
